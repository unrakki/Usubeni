REDIS_URL=redis://localhost:6379
# Metadata keys are optional; a source without its key answers 503
TMDB_API=
# Language for TMDB titles and synopses
TMDB_LANG=en-US
MAL_API=
IGDB_ID=
IGDB_SECRET=
HARDCOVER_API=
COMICVINE_API=
# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL the browser uses: the Vite dev server in dev, your domain in production
BETTER_AUTH_URL=http://localhost:5173
